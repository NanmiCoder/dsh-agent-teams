{
  "name": "@dengdengbei/projectflow-agent-teams",
  "version": "0.1.15",
  "description": "ProjectFlow Agent Teams: a lifecycle-oriented Agent Teams plugin for long-running software projects with persistent project context, quality gates, brownfield takeover, acceptance verification, and a redesigned UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/agent-teams",
    "assets/readme",
    "assets/ui.png",
    "cordis.patch.yml",
    "release-notes",
    "README.md",
    "README_ZH.md",
    "NOTICE.md"
  ],
  "license": "MIT",
  "author": {
    "name": "DengDengBei",
    "url": "https://github.com/DengDengBei"
  },
  "homepage": "https://github.com/DengDengBei/projectflow-agent-teams#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DengDengBei/projectflow-agent-teams.git"
  },
  "bugs": {
    "url": "https://github.com/DengDengBei/projectflow-agent-teams/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "multi-agent",
    "subagent",
    "ai-agent",
    "llm",
    "projectflow",
    "software-development-lifecycle",
    "long-running-projects",
    "project-context",
    "quality-gates"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "sync:skill": "node scripts/sync-skill.mjs",
    "verify:skill": "node scripts/sync-skill.mjs --check",
    "verify": "node scripts/verify.mjs && node scripts/fallback-tdd.mjs && node scripts/member-failure-tdd.mjs && node scripts/quality-gates-tdd.mjs && node scripts/lifecycle-verify.mjs && node scripts/stress-verify.mjs && pnpm verify:web-routes && pnpm verify:project-route && pnpm verify:approval-delivery && pnpm verify:project-phase4 && pnpm verify:captain-flow && pnpm verify:project-gate && pnpm verify:project-gate-materialization && pnpm verify:project-link-plan && pnpm verify:project-root-boundary && pnpm verify:brownfield-migration && pnpm verify:project-persistence && pnpm verify:package && pnpm verify:release && pnpm verify:skill && pnpm verify:product-e2e && pnpm verify:release-evidence",
    "prepublishOnly": "pnpm build && pnpm verify",
    "verify:web-routes": "node scripts/web-routes-verify.mjs",
    "verify:project-route": "node --experimental-strip-types scripts/project-route-verify.mjs",
    "verify:approval-delivery": "node --experimental-strip-types scripts/project-approval-delivery-verify.mjs",
    "verify:project-phase4": "node --experimental-strip-types scripts/project-phase4-verify.mjs",
    "verify:captain-flow": "node --experimental-strip-types scripts/captain-project-flow-verify.mjs",
    "verify:project-gate": "node scripts/project-gate-enforcement-verify.mjs",
    "verify:project-gate-materialization": "node scripts/project-gate-materialization-verify.mjs",
    "verify:project-link-plan": "node scripts/project-link-plan-verify.mjs",
    "verify:project-root-boundary": "node scripts/project-root-boundary-verify.mjs",
    "verify:brownfield-migration": "node --experimental-strip-types scripts/brownfield-migration-verify.mjs",
    "verify:project-persistence": "node scripts/project-persistence-verify.mjs",
    "verify:release-evidence": "node scripts/release-verification.mjs",
    "verify:product-e2e": "node scripts/product-e2e-verify.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node --test scripts/release-metadata.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.2",
